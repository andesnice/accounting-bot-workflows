    {
      "parameters": {
        "jsCode": "const pages = $input.all().map(item => item.json).filter(page => page?.id && page?.properties);\nconst transactions = pages.map(page => {\n  const props = page.properties;\n  let title = '未命名支出';\n  for (const value of Object.values(props)) {\n    if (value?.type === 'title') {\n      title = value.title?.[0]?.plain_text || '未命名支出';\n      break;\n    }\n  }\n  return {\n    id: page.id,\n    title,\n    category: props['支出類型']?.select?.name || '未分類',\n    amount: Number(props['金額']?.number || 0),\n    date: props['Date']?.date?.start?.slice(0, 10) || '',\n    payment: props['付款方式']?.select?.name || '未設定',\n    url: page.url || ''\n  };\n}).filter(item => item.date && item.amount > 0);\ntransactions.sort((a, b) => b.date.localeCompare(a.date));\nreturn [{ json: { ok: true, transactions } }];"
      },
