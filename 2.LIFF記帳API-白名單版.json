    {
      "parameters": {
        "jsCode": "const request = $('解析記帳請求').item.json;\nconst lineProfile = $json || {};\n\n// 開放版：任何通過 LINE 登入（取得 userId）的使用者都可記帳，不再比對白名單。\nconst allowedActions = ['list', 'create', 'delete'];\nconst validAction = allowedActions.includes(request.action);\nconst validPayload = request.action === 'create'\n  ? Boolean(request.title && request.category && request.payment && request.amount > 0 && /^\\d{4}-\\d{2}-\\d{2}$/.test(request.date))\n  : request.action === 'list'\n    ? true\n    : Boolean(request.pageId);\nconst authorized = Boolean(lineProfile.userId) && validAction && validPayload;\n\nlet message = '';\nif (!lineProfile.userId) message = 'LINE 登入已失效，請關閉後重新開啟。';\nelse if (!validAction || !validPayload) message = '記帳內容不完整。';\n\nreturn [{ json: {\n  ...request,\n  authorized,\n  message,\n  userId: lineProfile.userId || '',\n  displayName: lineProfile.displayName || ''\n} }];"
      },
