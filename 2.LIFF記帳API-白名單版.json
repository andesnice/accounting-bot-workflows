    {
      "parameters": {
        "jsCode": "let body = $json.body;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch { body = {}; }\n}\nbody = body && typeof body === 'object' ? body : {};\nconst amount = Number(body.amount);\nconst allowedCategories = ['食物','服飾','日常用品','交通','稅收','手機費','油錢','停車費','休閒','宮廟','醫療','玉山存錢','卡費','暫付','罰單','車','工具','投資','酒煙','房貸','訂閱'];\nconst allowedPayments = ['街口支付','富邦轉帳','Line','現金','玉山刷卡','富邦付款','遠傳扣款','台灣銀行扣款'];\n\nreturn [{ json: {\n  action: String(body.action || '').trim(),\n  accessToken: String(body.accessToken || '').trim(),\n  pageId: String(body.pageId || '').replace(/[^a-zA-Z0-9-]/g, ''),\n  title: String(body.title || '').trim().slice(0, 100),\n  category: allowedCategories.includes(body.category) ? body.category : '',\n  payment: allowedPayments.includes(body.payment) ? body.payment : '',\n  amount: Number.isFinite(amount) ? amount : 0,\n  date: String(body.date || '').trim()\n} }];"
      },
      "id": "d99f8d1d-5f89-4d53-923c-b22d00d73717",
